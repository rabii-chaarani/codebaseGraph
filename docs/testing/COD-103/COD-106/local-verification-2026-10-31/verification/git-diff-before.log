+fn assert_resolver_rejected(f: &Fixture, output: &Output) {
+    assert!(
+        !output.status.success(),
+        "unexpected authorization: {}",
+        String::from_utf8_lossy(&output.stdout)
+    );
+    assert!(f.output().is_empty(), "{}", f.output());
+    assert!(!f.root.join("summary").exists());
+    f.assert_no_writes();
+}
