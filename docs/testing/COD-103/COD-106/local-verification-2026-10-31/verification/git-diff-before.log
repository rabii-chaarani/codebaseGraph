+        !output.status.success(),
+        "unexpected upload: {}",
+        String::from_utf8_lossy(&output.stdout)
+    );
+    assert_eq!(f.release_snapshot(), release_before);
+    assert_eq!(f.assets_snapshot(), assets_before);
+    f.assert_no_writes();
+}
