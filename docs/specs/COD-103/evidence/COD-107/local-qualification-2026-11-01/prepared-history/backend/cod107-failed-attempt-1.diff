+fn has_generated_component(path: &Path) -> bool {
+    path.components().any(|component| {
+        matches!(
+            component,
+            std::path::Component::Normal(name)
+                if matches!(name.to_str(), Some(".git" | "target" | ".codebaseGraph" | ".kwiki"))
+        )
+    })
